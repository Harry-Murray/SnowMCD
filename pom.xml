<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.snowmcd</groupId>
  <artifactId>snowmcd</artifactId>
  <version>1.0.0</version>
  <name>SnowMCD</name>
  <description>Minecraft full-file downloader using the BMCLAPI mirror</description>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <javafx.version>25.0.5</javafx.version>
    <gson.version>2.14.0</gson.version>
    <main.module>com.snowmcd</main.module>
    <main.class>com.snowmcd.Main</main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>snowmcd-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-Xlint:all,-serial,-this-escape</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
            <manifestEntries>
              <Implementation-Title>SnowMCD</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.module}/${main.class}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Cross-platform fat jar: bundles JavaFX for win / mac / mac-aarch64 / linux / linux-aarch64. -->
    <profile>
      <id>crossjar</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>copy-cross-platform-libs</id>
                <phase>package</phase>
                <goals>
                  <goal>copy</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                      <version>${javafx.version}</version><classifier>win</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/win</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                      <version>${javafx.version}</version><classifier>win</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/win</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                      <version>${javafx.version}</version><classifier>win</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/win</outputDirectory>
                    </artifactItem>

                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                      <version>${javafx.version}</version><classifier>mac</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/mac</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                      <version>${javafx.version}</version><classifier>mac</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/mac</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                      <version>${javafx.version}</version><classifier>mac</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/mac</outputDirectory>
                    </artifactItem>

                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                      <version>${javafx.version}</version><classifier>mac-aarch64</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/mac-aarch64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                      <version>${javafx.version}</version><classifier>mac-aarch64</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/mac-aarch64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                      <version>${javafx.version}</version><classifier>mac-aarch64</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/mac-aarch64</outputDirectory>
                    </artifactItem>

                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                      <version>${javafx.version}</version><classifier>linux</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/linux</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                      <version>${javafx.version}</version><classifier>linux</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/linux</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                      <version>${javafx.version}</version><classifier>linux</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/linux</outputDirectory>
                    </artifactItem>

                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                      <version>${javafx.version}</version><classifier>linux-aarch64</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/linux-aarch64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                      <version>${javafx.version}</version><classifier>linux-aarch64</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/linux-aarch64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                      <version>${javafx.version}</version><classifier>linux-aarch64</classifier><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/linux-aarch64</outputDirectory>
                    </artifactItem>

                    <artifactItem>
                      <groupId>com.google.code.gson</groupId><artifactId>gson</artifactId>
                      <version>${gson.version}</version><type>jar</type>
                      <outputDirectory>${project.build.directory}/cross-libs/common</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                  <overWriteReleases>false</overWriteReleases>
                  <overWriteSnapshots>false</overWriteSnapshots>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
